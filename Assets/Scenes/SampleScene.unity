--- !u!114 &901228277
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 901228273}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3e6983d1ac9fd944e8e684f82d939647, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  Lines:
  - 'Hello young tadpole, and welcome! You may ask yourself why you are here, and
    it is because I! The great and mysterious frog mage! Have brought you here to
    partake in the Rudimentary Informational Bounce and Bound Initiative Training!
    Code: RIBIIT.'
  - "To complete the challenge you must collect my 6 hats! Now to tell you where
    they are would be telling. Clues? Uh \u2026 those would also spoil the challenge!
    So off! "
  textbox: {fileID: 1937663773}
  Timer: 10
  Panel: {fileID: 1670884665}
