  m_Script: {fileID: 11500000, guid: 3e6983d1ac9fd944e8e684f82d939647, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  Lines:
  - 'Now, you might stumble across this and ask yourself: why put me here? How am
    I supposed to get up?'
  - 'Well, my little apprentice, herein lies the first rule of the caves: mushrooms
    make for a most delightful means of traversal! See a wall that you cannot possible
    hope to climb? Well, if there''s a mushroom in sight you can simply bounce your
    way to victory!'
  textbox: {fileID: 1937663773}
  Timer: 10
  Panel: {fileID: 1670884665}
